# ─────────────────────────────────────────────────────────────
# FitTrack AI — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local for local development
# 2. Add ALL these to Vercel → Project → Settings → Environment Variables
# 3. NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────
# Get both from: Supabase dashboard → your project → Settings → API
REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx
