# ─────────────────────────────────────────────────────────────
# FitTrack AI — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local for local development
# 2. Add ALL these variables to Vercel → Project → Settings → Environment Variables
# 3. NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────────

# ── Anthropic ─────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase ──────────────────────────────────────────────────
# Get ALL of these from:
# Firebase Console → Project Settings → Your Apps → Web App → SDK snippet
REACT_APP_FIREBASE_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
