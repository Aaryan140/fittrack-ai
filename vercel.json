{
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "devCommand": "react-scripts start",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)",       "destination": "/index.html"  }
  ],
  "functions": {
    "api/claude.js": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}